# =====================================================================
#  LeadCatch & QuickBook — Переменные окружения (Пример)
# =====================================================================

NODE_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Tashkent
PUBLIC_BASE_URL=
BOT_MODE=polling
USE_MOCK_TELEGRAM=false
ADMIN_ORIGIN=http://localhost:5173

PG_SUPERUSER_PASSWORD=
DATABASE_URL="postgresql://lcqb_app:password@127.0.0.1:5433/leadcatch_quickbook_dev?schema=public"
TEST_DATABASE_URL="postgresql://lcqb_app:password@127.0.0.1:5433/leadcatch_quickbook_test?schema=public"

REDIS_URL=redis://127.0.0.1:6379/0
TEST_REDIS_URL=redis://127.0.0.1:6379/1

TOKEN_ENCRYPTION_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change_me_secure_password_123

PAYMENT_DETAILS="Карта: 8600 0000 0000 0000\nПолучатель: Admin"
SUPPORT_CONTACT=@support
TRIAL_DAYS_DEFAULT=3
TARIFF_1M_UZS=100000
TARIFF_6M_UZS=500000
TARIFF_12M_UZS=1000000

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

DEV_LEADCATCH_TOKEN=
DEV_QUICKBOOK_TOKEN=
