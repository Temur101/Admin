{
  "$schema": "https://unpkg.com/knip@5/overview/config-schema.json",
  "ignore": [".agents/**"],
  "workspaces": {
    "apps/server": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/admin": {
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"],
      "entry": ["test/**/*.test.ts", "test/**/*.test.tsx"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": ["pino-pretty", "@vitest/coverage-v8", "rimraf"],
  "ignoreExportsUsedInFile": true
}
