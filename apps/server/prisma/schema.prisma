generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BotType {
  LEADCATCH
  QUICKBOOK
}

enum SubStatus {
  TRIAL
  ACTIVE
  EXPIRED
  GRACE_PERIOD
  BLOCKED
}

enum ReceiptKind {
  PHOTO
  TEXT
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum InboxStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
}

enum Lang {
  RU
  UZ
}

enum BookingSource {
  TELEGRAM
  MANUAL
}

enum BotAdminRole {
  OWNER
  STAFF
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED
}

model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  clientName   String   @db.VarChar(255)
  contactPhone String   @db.VarChar(50)
  status       String   @default("ACTIVE") @db.VarChar(32)
  createdAt    DateTime @default(now()) @db.Timestamptz
  bots         Bot[]
}

model Bot {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  botType         BotType
  botTokenEnc     String
  botTokenHash    String           @unique @db.VarChar(64)
  webhookSecret   String           @db.VarChar(64)
  botUsername     String?          @db.VarChar(100)
  settings        Json             @default("{}")
  isActive        Boolean          @default(true)
  healthStatus    String           @default("OK") @db.VarChar(32)
  lastErrorCode   String?          @db.VarChar(64)
  lastErrorMsg    String?
  lastErrorAt     DateTime?        @db.Timestamptz
  createdAt       DateTime         @default(now()) @db.Timestamptz
  subscription    Subscription?
  users           BotUser[]
  invites         AdminInvite[]
  leads           Lead[]
  bookings        Booking[]
  timeBlocks      TimeBlock[]
  settingsLogs    BotSettingsLog[]
  receipts        PaymentReceipt[]
  inbox           WebhookInbox[]
  notificationDeliveries NotificationDelivery[]
}

model Subscription {
  id                    String    @id @default(uuid()) @db.Uuid
  botId                 String    @unique @db.Uuid
  bot                   Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  status                SubStatus @default(TRIAL)
  trialEndsAt           DateTime  @db.Timestamptz
  paidUntil             DateTime? @db.Timestamptz
  failedReceiptAttempts Int       @default(0)
  updatedAt             DateTime  @updatedAt @db.Timestamptz
}

model BotUser {
  id            String        @id @default(uuid()) @db.Uuid
  botId         String        @db.Uuid
  bot           Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  tgId          BigInt
  firstName     String?       @db.VarChar(255)
  username      String?       @db.VarChar(100)
  lang          Lang?
  isAdmin       Boolean       @default(false)
  role          BotAdminRole?
  receivesLeads Boolean       @default(true)
  unreachableAt DateTime?     @db.Timestamptz
  createdAt     DateTime      @default(now()) @db.Timestamptz

  @@unique([botId, tgId])
  @@index([botId, isAdmin])
}

model AdminInvite {
  id         String       @id @default(uuid()) @db.Uuid
  botId      String       @db.Uuid
  bot        Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  role       BotAdminRole @default(OWNER)
  codeHash   String       @unique @db.VarChar(64)
  expiresAt  DateTime     @db.Timestamptz
  usedAt     DateTime?    @db.Timestamptz
  usedByTgId BigInt?
  revokedAt  DateTime?    @db.Timestamptz
  createdAt  DateTime     @default(now()) @db.Timestamptz

  @@index([botId, revokedAt, usedAt])
}

model PaymentReceipt {
  id              String        @id @default(uuid()) @db.Uuid
  botId           String        @db.Uuid
  bot             Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  submittedByTgId BigInt
  kind            ReceiptKind
  imagePath       String?       @db.VarChar(500)
  telegramFileId  String?       @db.VarChar(255)
  textNote        String?
  months          Int
  amount          Int
  optimisticGranted Boolean @default(false)
  prevPaidUntil   DateTime?     @db.Timestamptz
  prevStatus      SubStatus
  grantedUntil    DateTime      @db.Timestamptz
  status          ReceiptStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime      @default(now()) @db.Timestamptz
  reviewedAt      DateTime?     @db.Timestamptz

  @@index([status, createdAt])
}

model Lead {
  id               String     @id @default(uuid()) @db.Uuid
  botId            String     @db.Uuid
  bot              Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)
  customerTgId     BigInt
  customerName     String?    @db.VarChar(255)
  customerUsername String?    @db.VarChar(100)
  phoneRaw         String     @db.VarChar(50)
  phoneVerified    Boolean    @default(false)
  answers          Json
  status           LeadStatus @default(NEW)
  assigneeTgId     BigInt?
  assignedAt       DateTime?  @db.Timestamptz
  statusChangedAt  DateTime?  @db.Timestamptz
  notificationRefs Json       @default("[]")
  isMasked         Boolean    @default(false)
  createdAt        DateTime   @default(now()) @db.Timestamptz

  @@index([botId, createdAt])
  @@index([botId, status, createdAt])
}

/// Enforced via SQL migrations in PostgreSQL:
/// - Partial unique index `booking_slot_active_uq` on (botId, staffId, slotTime) WHERE status IN ('PENDING', 'CONFIRMED')
/// - GiST exclusion constraint `booking_no_overlap_excl` on (botId WITH =, staffId WITH =, tstzrange(slotTime, endTime) WITH &&) WHERE status IN ('PENDING', 'CONFIRMED')
model Booking {
  id                  String        @id @default(uuid()) @db.Uuid
  botId               String        @db.Uuid
  bot                 Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  customerTgId        BigInt?
  customerName        String?       @db.VarChar(255)
  customerPhone       String        @db.VarChar(50)
  phoneVerified       Boolean       @default(false)
  serviceId           String        @db.VarChar(64)
  serviceName         String        @db.VarChar(255)
  staffId             String        @db.VarChar(64)
  durationMin         Int
  slotTime            DateTime      @db.Timestamptz
  endTime             DateTime?     @db.Timestamptz
  status              BookingStatus @default(PENDING)
  source              BookingSource @default(TELEGRAM)
  createdByTgId       BigInt?
  reminderSent        Boolean       @default(false)
  reminderAttempts    Int           @default(0)
  reminderLockedUntil DateTime?     @db.Timestamptz
  reminderLastError   String?
  isMasked            Boolean       @default(false)
  createdAt           DateTime      @default(now()) @db.Timestamptz

  @@index([botId, slotTime])
  @@index([botId, staffId, status, slotTime, endTime])
  @@index([reminderSent, status, slotTime])
}

model TimeBlock {
  id            String   @id @default(uuid()) @db.Uuid
  botId         String   @db.Uuid
  bot           Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  resourceId    String   @db.VarChar(64)
  startsAt      DateTime @db.Timestamptz
  endsAt        DateTime @db.Timestamptz
  reason        String?  @db.VarChar(255)
  createdByTgId BigInt?
  createdAt     DateTime @default(now()) @db.Timestamptz

  @@index([botId, resourceId, startsAt, endsAt])
}

model BotSettingsLog {
  id               String   @id @default(uuid()) @db.Uuid
  botId            String   @db.Uuid
  bot              Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  changedByTgId    BigInt?
  changedByAdminId String?  @db.Uuid
  changes          Json
  createdAt        DateTime @default(now()) @db.Timestamptz

  @@index([botId, createdAt])
}

model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz
}

model PlatformSettings {
  id                  Int      @id @default(1)
  paymentDetails      String
  tariffs             Json
  supportContact      String
  alertBotTokenEnc    String?
  alertChatId         String?  @db.VarChar(100)
  alertBotUsername    String?  @db.VarChar(100)
  paymentInstructions String?  @db.Text
  maintenanceMode     Boolean  @default(false)
  updatedAt           DateTime @updatedAt @db.Timestamptz
}

model WebhookInbox {
  id          String      @id @default(uuid()) @db.Uuid
  botId       String      @db.Uuid
  bot         Bot         @relation(fields: [botId], references: [id], onDelete: Cascade)
  updateId    BigInt
  payload     Json
  status      InboxStatus @default(RECEIVED)
  attempts    Int         @default(0)
  maxAttempts Int         @default(3)
  lockedUntil DateTime?   @db.Timestamptz
  lastError   String?
  createdAt   DateTime    @default(now()) @db.Timestamptz
  processedAt DateTime?   @db.Timestamptz

  @@unique([botId, updateId])
  @@index([status, lockedUntil])
  @@index([botId, status])
}


model NotificationDelivery {
  id String @id @default(uuid()) @db.Uuid
  botId String @db.Uuid
  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)
  eventKey String @db.VarChar(255)
  recipientTgId BigInt
  payload Json
  status String @default("PENDING") @db.VarChar(16)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz
  lockedUntil DateTime? @db.Timestamptz
  leaseToken String? @db.Uuid
  lastError String?
  deliveredAt DateTime? @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  @@unique([eventKey, recipientTgId])
  @@index([status, availableAt, lockedUntil])
  @@index([botId, status])
}
